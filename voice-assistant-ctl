#!/bin/bash
# Voice Assistant control script.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SERVICE_NAME="voice-assistant.service"
STATE_DIR="$HOME/.local/state/voice-assistant"
PID_FILE="$STATE_DIR/voice-assistant.pid"
SESSION_FILE="$STATE_DIR/session_id"
LOG_FILE="$STATE_DIR/voice-assistant.log"
# The repo, wherever this script was installed from.
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

# The running process is `python3 voice_assistant.py`, so matching the string
# "voice-assistant" finds shells and editors, not the assistant. The pid file
# is the only reliable handle.
assistant_pid() {
    [[ -f "$PID_FILE" ]] || return 1
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && { echo "$pid"; return 0; }
    return 1
}

show_status() {
    echo "🎤 Voice Assistant Status"
    echo "========================"

    if systemctl --user is-active "$SERVICE_NAME" &>/dev/null; then
        echo -e "Service:  ${GREEN}ACTIVE${NC}"
    else
        echo -e "Service:  ${RED}INACTIVE${NC}"
    fi

    if PID=$(assistant_pid); then
        echo -e "Process:  ${GREEN}RUNNING${NC} (PID $PID)"
    else
        echo -e "Process:  ${RED}NOT RUNNING${NC}"
    fi

    # Whatever the assistant last wrote for waybar is its live state.
    if [[ -f "$STATE_DIR/waybar-status" ]]; then
        STATE=$(sed -n 's/.*"class": *\[ *"\([a-z]*\)".*/\1/p' "$STATE_DIR/waybar-status")
        BACKEND=$(sed -n 's/.*"class": *\[ *"[a-z]*", *"\([a-z]*\)".*/\1/p' "$STATE_DIR/waybar-status")
        echo -e "Voice:    ${GREEN}${STATE:-unknown}${NC}   Backend: ${GREEN}${BACKEND:-unknown}${NC}"
    fi

    if [[ -s "$SESSION_FILE" ]]; then
        SID=$(cat "$SESSION_FILE")
        echo -e "Session:  ${GREEN}${SID:0:12}…${NC} (continuing)"
    else
        echo -e "Session:  ${YELLOW}NONE${NC} (next query starts fresh)"
    fi

    if [[ -f "$LOG_FILE" ]]; then
        echo -e "Log:      ${GREEN}$(du -h "$LOG_FILE" | cut -f1)${NC} ($LOG_FILE)"
    else
        echo -e "Log:      ${YELLOW}NOT FOUND${NC}"
    fi

    if command -v voice-llm &>/dev/null; then
        echo
        voice-llm status
    fi
}

start_service() {
    log_info "Starting voice assistant..."
    systemctl --user start "$SERVICE_NAME"
    sleep 2
    if systemctl --user is-active "$SERVICE_NAME" &>/dev/null; then
        log_success "Voice assistant started"
    else
        log_error "Failed to start. journalctl --user -u $SERVICE_NAME -n 40"
        exit 1
    fi
}

stop_service() {
    log_info "Stopping voice assistant..."
    systemctl --user stop "$SERVICE_NAME"
    log_success "Voice assistant stopped"
}

restart_service() {
    log_info "Restarting voice assistant..."
    systemctl --user restart "$SERVICE_NAME"
    sleep 2
    if systemctl --user is-active "$SERVICE_NAME" &>/dev/null; then
        log_success "Voice assistant restarted"
    else
        log_error "Failed to restart. journalctl --user -u $SERVICE_NAME -n 40"
        exit 1
    fi
}

_send_signal() {
    local pid
    pid=$(assistant_pid) || return 1
    kill -"$1" "$pid"
}

toggle_voice() {
    if _send_signal USR1; then
        log_success "Voice mode toggled"
    else
        log_error "Voice assistant is not running"
        exit 1
    fi
}

new_session() {
    if _send_signal USR2; then
        log_success "New conversation will begin on the next query"
    else
        log_warning "Voice assistant is not running; clearing persisted session..."
        rm -f "$SESSION_FILE" "$STATE_DIR/local_history.json"
        log_success "Session cleared"
    fi
}

show_logs() {
    if [[ "$1" == "-f" ]]; then
        journalctl --user -u "$SERVICE_NAME" -n 50 -f
    else
        journalctl --user -u "$SERVICE_NAME" -n "${1:-50}"
    fi
}

run_test() {
    # Use the project's venv, not whatever python happens to be on PATH: the
    # dependencies only exist inside it.
    local py="$REPO_DIR/.venv/bin/python"
    [[ -x "$py" ]] || py=python3
    if [[ -f "$REPO_DIR/test_installation.py" ]]; then
        log_info "Running installation checks..."
        "$py" "$REPO_DIR/test_installation.py"
    else
        log_error "test_installation.py not found next to this script ($REPO_DIR)"
        exit 1
    fi
}

show_help() {
    cat << EOF
Voice Assistant Control Script
==============================

Usage: $(basename "$0") <command>

Commands:
  status       Service, voice state, backend, session and log
  start        Start the service
  stop         Stop the service
  restart      Restart the service
  toggle       Toggle voice mode on/off (same as tapping SUPER)
  new-session  Start a new conversation
  logs [N]     Show the last N lines (default 50)
  logs -f      Follow the logs
  test         Run the installation checks
  backend      Show or change the LLM backend (see: voice-llm)
  help         This message

Examples:
  $(basename "$0") status
  $(basename "$0") logs -f
  $(basename "$0") backend claude
EOF
}

case "${1:-}" in
    status|stat)          show_status ;;
    start)                start_service ;;
    stop)                 stop_service ;;
    restart|reload)       restart_service ;;
    toggle)               toggle_voice ;;
    new-session|new|reset) new_session ;;
    logs|log)             show_logs "${2:-50}" ;;
    test)                 run_test ;;
    backend)              shift; voice-llm "${@:-status}" ;;
    help|-h|--help)       show_help ;;
    *)
        log_error "Unknown command: ${1:-}"
        echo
        show_help
        exit 1
        ;;
esac
