[Unit]
Description=Voice Assistant (Hyprland or GNOME on Wayland)
Documentation=https://github.com/fursman/Assistant
After=pipewire.service
Wants=pipewire.service
# Deliberately NOT ordered after qwen38.service. Type=exec would only mean
# "the binary exec'd", and a real readiness gate would hold the assistant's own
# 4 s of model loading behind the LLM's 35 s. Instead the assistant starts
# immediately, answers with Claude while the local model loads, and adopts the
# local model as soon as its /health endpoint says it is serving.

[Service]
Type=simple
# Backend selection (auto | claude | local | dsh) and the rest of the runtime
# configuration. Optional: the leading "-" means the service still starts if
# the file is absent, and the built-in defaults apply.
EnvironmentFile=-%h/.config/voice-assistant/env
# Wait for the graphical session. default.target comes up at login BEFORE the
# compositor does (Hyprland ~16 s later on Blade17, ~5 s on Block), and the
# desktop, WAYLAND_DISPLAY and the Hyprland socket are discovered once, at
# startup, and written into the model's system prompt -- so a boot-time start
# ran the whole session as "an unidentified desktop" with no notifications.
# Ready = a Wayland socket exists and the session has exported
# XDG_CURRENT_DESKTOP to the user manager (Hyprland and GNOME both do), or 10 s
# after the socket without it. Headless: gives up after 120 s and starts anyway.
ExecStartPre=/bin/sh -c 'n=0; up=0; while [ $$n -lt 120 ]; do for s in "$$XDG_RUNTIME_DIR"/wayland-[0-9]*; do case "$$s" in *.lock) ;; *) [ -S "$$s" ] && up=$$((up+1)) && break ;; esac; done; if [ $$up -gt 0 ]; then systemctl --user show-environment | grep -q "^XDG_CURRENT_DESKTOP=" && exit 0; [ $$up -ge 10 ] && exit 0; fi; n=$$((n+1)); sleep 1; done; echo "no graphical session after 120 s; starting without one"'
TimeoutStartSec=180
ExecStart=%h/.local/bin/voice-assistant
Restart=on-failure
RestartSec=5
Environment="PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin"
# %t is systemd's runtime directory (/run/user/$UID) -- do not hardcode 1000,
# it is wrong for any user who is not the first one on the machine.
Environment="XDG_RUNTIME_DIR=%t"
# WAYLAND_DISPLAY, XDG_CURRENT_DESKTOP and HYPRLAND_INSTANCE_SIGNATURE are
# deliberately NOT set here: they are named per session, so any fixed value is
# wrong somewhere. voice_assistant.py discovers them at startup instead.

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voice-assistant

[Install]
WantedBy=default.target
