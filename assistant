#!/usr/bin/env python3
"""Talk to the running voice assistant from a terminal.

    assistant what is using all my disk space
    assistant "remind me what we decided about the tomatoes"
    assistant --image ~/Downloads/plant.jpg "what is wrong with this leaf"
    assistant --swap                 # local -> each network server -> Claude, notified
    assistant --backend network      # or local, claude (hosted), dsh, auto
    assistant --model fable          # or opus, sonnet, haiku
    assistant --effort xhigh         # or low, medium, high, max
    assistant --voice-only on        # or off, toggle: ignore voices but yours
    assistant --status
    assistant --new                  # start a fresh conversation

The point is that this is the SAME conversation as the spoken one: same
history, same session, same tools. Ask by voice, follow up by typing, and
either one can refer to what the other said.

Nothing is spoken unless you ask for it with --speak, on the assumption that
if you are typing you would rather read the answer than wait for it to be
read out.

With --image, a model that can see gets the picture itself; Claude gets its
path and opens it; a model that cannot see is told it was attached.
"""
import argparse
import json
import os
import socket
import sys
from pathlib import Path

SOCKET = Path(os.getenv(
    "VOICE_ASSISTANT_SOCKET",
    str(Path(os.getenv("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
        / "voice-assistant.sock")))

# Long enough for a local model that is still loading plus a few tool calls.
TIMEOUT = float(os.getenv("VOICE_ASSISTANT_CLI_TIMEOUT", "300"))


def request(payload: dict) -> dict:
    if not SOCKET.exists():
        die("the voice assistant is not running (no control socket at "
            f"{SOCKET}).\nStart it with: systemctl --user start voice-assistant.service")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(TIMEOUT)
    try:
        s.connect(str(SOCKET))
    except OSError as e:
        die(f"could not reach the assistant: {e}")
    try:
        s.sendall((json.dumps(payload) + "\n").encode())
        # One reply, one line. Read until the newline rather than a fixed
        # size: a long answer arrives in several TCP-ish chunks even on a
        # Unix socket.
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    except socket.timeout:
        die(f"the assistant did not answer within {TIMEOUT:.0f}s")
    except OSError as e:
        die(f"lost the connection: {e}")
    finally:
        s.close()
    if not buf.strip():
        die("the assistant closed the connection without answering")
    try:
        return json.loads(buf)
    except json.JSONDecodeError as e:
        die(f"could not read the reply: {e}")


def die(message: str, code: int = 1):
    print(f"assistant: {message}", file=sys.stderr)
    raise SystemExit(code)


def main():
    p = argparse.ArgumentParser(
        prog="assistant", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("words", nargs="*", help="your question, quoted or not")
    p.add_argument("--speak", action="store_true", help="read the answer aloud too")
    p.add_argument("--image", metavar="FILE",
                   help="send this image with the question (PNG, JPEG, GIF, WebP, BMP, TIFF)")
    p.add_argument("--swap", action="store_true",
                   help="cycle local model -> each network model server found on "
                        "the LAN -> Claude, skipping what is not here or not answering")
    p.add_argument("--model", choices=("opus", "sonnet", "haiku", "fable"),
                   help="Claude model to use from here on")
    p.add_argument("--effort", choices=("low", "medium", "high", "xhigh", "max"),
                   help="Claude effort level to use from here on")
    p.add_argument("--backend", choices=("local", "network", "claude", "hosted", "dsh", "auto"),
                   help="select a backend explicitly (hosted = claude; dsh = the local "
                        "model under the DeepSeek Harness)")
    p.add_argument("--voice-only", choices=("on", "off", "toggle"),
                   help="ignore every voice but yours (needs a learned voiceprint; "
                        "until then everyone is heard)")
    p.add_argument("--status", action="store_true", help="show what is running")
    p.add_argument("--new", action="store_true", help="start a fresh conversation")
    p.add_argument("--json", action="store_true", help="print the raw reply")
    args = p.parse_args()

    if args.model or args.effort:
        r = request({"cmd": "claude", "model": args.model, "effort": args.effort})
    elif args.voice_only:
        r = request({"cmd": "voice_only", "value": args.voice_only})
    elif args.swap or args.backend:
        r = request({"cmd": "backend", "value": args.backend or "toggle"})
    elif args.status:
        r = request({"cmd": "status"})
    elif args.new:
        r = request({"cmd": "new_session"})
    else:
        question = " ".join(args.words).strip()
        if not question and not (args.image and sys.stdin.isatty()):
            if sys.stdin.isatty():
                p.print_help()
                return 0
            question = sys.stdin.read().strip()      # assistant < notes.txt
        if not question and args.image:
            question = "What is in this image?"
        if not question:
            die("nothing to ask")
        payload = {"cmd": "ask", "text": question, "speak": args.speak}
        if args.image:
            # The service has another working directory: send the whole path.
            # Whether it is an image the service checks, with the rest.
            image = Path(args.image).expanduser().resolve()
            if not image.is_file():
                die(f"no such file: {args.image}")
            payload["image"] = str(image)
        r = request(payload)

    if args.json:
        print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    if not r.get("ok"):
        die(r.get("error", "unknown error"))

    if "reply" in r:
        print(r["reply"])
    elif args.status:
        voice = "listening" if r["voice_active"] else "off"
        print(f"model      {r['label']}  (preference: {r['preference']})")
        print(f"local llm  {r['local_llm']}")
        if r.get("network_llm"):
            print(f"network    {r['network_llm']}  {r.get('network_url') or ''}".rstrip())
        servers = r.get("network_servers")
        if servers is not None:
            scan = r.get("network_scan")
            when = ("discovery off" if scan == "off" else "first scan pending" if scan == "pending"
                    else f"scanned {scan // 60} min ago" if isinstance(scan, int) and scan >= 60
                    else "scanned just now" if isinstance(scan, int) else "")
            print(f"servers    {len(servers)} known{f'  ({when})' if when else ''}")
            for s in servers:
                mark = "*" if s.get("current") else " "
                print(f"         {mark} {s.get('label', '?'):<18} {s.get('model') or '?':<24} {s['url']}"
                      + ("  (configured)" if s.get("configured") else ""))
        print(f"dsh        {r.get('dsh', 'unknown')}")
        print(f"voice      {voice}{'  (busy)' if r['busy'] else ''}")
        if "voice_only" in r:
            vp = r.get("voiceprint")
            print(f"voice-only {'on' if r['voice_only'] else 'off'}"
                  f"{f'  (voiceprint {vp})' if vp else ''}")
        print(f"session    {r['session']}")
    else:
        note = r.get("note") or ""
        print(f"{r.get('label', r.get('message', 'done'))}{' ' + note if note else ''}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
