#!/bin/bash
# Switch the voice assistant between the Claude Code CLI and the local
# Qwen3.8-27B llama-server, and start/stop the model server to match.
#
#   voice-llm status | auto | claude | qwen | network | dsh | logs | discover
#
# `network` is a llama-server on another machine (VOICE_ASSISTANT_NETWORK_URL
# in the env file); nothing here starts or stops it. `discover` looks for one
# on the LAN and prints what it finds; setup.sh offers the first.
#
# `dsh` is the same local model driven by the DeepSeek Harness (DeepSeek's
# open-source agent runtime, run locally through its Python SDK) instead of the
# assistant's own tool loop.
#
# The default is `auto`: the assistant uses the local model when this machine
# has a >= 16 GB NVIDIA GPU and qwen38.service is installed, and the claude CLI
# otherwise -- including for individual queries while the model is still
# loading. `claude` and `qwen` force one or the other.
#
# The local model holds ~15.3 GB of the 16 GB dGPU while it runs, so
# `voice-llm claude` stops it -- that is what frees the card for GPU
# passthrough to a VM.
set -euo pipefail

ENV_FILE="$HOME/.config/voice-assistant/env"
# The repo this script was installed from (the venv with the harness SDK).
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
[[ -x "$REPO_DIR/.venv/bin/python" ]] || REPO_DIR="$HOME/voice-assistant"
ASSISTANT="voice-assistant.service"
# The model server unit and its alias come from the env file, so a machine can
# serve a different local model (e.g. Flash-Next on a 24 GB card) under its own
# unit. Same keys the assistant reads: VOICE_ASSISTANT_LOCAL_UNIT / _MODEL.
env_value() {
    [[ -r "$ENV_FILE" ]] || return 0
    grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- || true
}
SERVER="$(env_value VOICE_ASSISTANT_LOCAL_UNIT)"; SERVER="${SERVER:-qwen38.service}"
MODEL_NAME="$(env_value VOICE_ASSISTANT_LOCAL_MODEL)"; MODEL_NAME="${MODEL_NAME:-qwen3.8-27b}"
NETWORK_URL="$(env_value VOICE_ASSISTANT_NETWORK_URL)"
HEALTH="http://127.0.0.1:8081/health"
MIN_VRAM=15000

GREEN='\033[0;32m'; RED='\033[0;31m'; YEL='\033[1;33m'; BLU='\033[0;34m'; NC='\033[0m'
info() { echo -e "${BLU}[INFO]${NC} $1"; }
ok()   { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YEL}[WARN]${NC} $1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1"; }

current_backend() {
    local b=""
    if [[ -r "$ENV_FILE" ]]; then
        b=$(grep -E '^VOICE_ASSISTANT_LLM_BACKEND=' "$ENV_FILE" | tail -1 | cut -d= -f2 || true)
    fi
    echo "${b:-auto}"
}

set_backend() {
    mkdir -p "$(dirname "$ENV_FILE")"
    touch "$ENV_FILE"
    if grep -qE '^VOICE_ASSISTANT_LLM_BACKEND=' "$ENV_FILE"; then
        sed -i "s/^VOICE_ASSISTANT_LLM_BACKEND=.*/VOICE_ASSISTANT_LLM_BACKEND=$1/" "$ENV_FILE"
    else
        echo "VOICE_ASSISTANT_LLM_BACKEND=$1" >> "$ENV_FILE"
    fi
}

# ready = serving; loading = port open but weights not in yet (llama-server
# answers 503 for 5-35 s); down = nothing listening.
server_state() {
    local code
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$HEALTH" 2>/dev/null || echo 000)
    case "$code" in 200) echo ready;; 503) echo loading;; *) echo down;; esac
}

gpu_vram() {   # "<name>|<total MiB>" for the largest card, or nothing
    command -v nvidia-smi &>/dev/null || return 1
    local row
    row=$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader,nounits 2>/dev/null \
          | sort -t, -k2 -nr | head -1) || return 1
    [[ -n "$row" ]] || return 1
    echo "$row" | sed 's/, */|/'
}

# Mirrors VoiceAssistant._resolve_backend() so `status` says what the assistant
# will actually do, not just what is configured.
resolve_backend() {
    local cfg="$1" gpu total st
    case "$cfg" in claude|local|dsh) echo "$cfg (forced)"; return;; hosted) echo "claude (forced)"; return;; esac
    if [[ "$cfg" == network && -n "$NETWORK_URL" ]]; then echo "network (forced, $NETWORK_URL)"; return; fi
    # Where auto settles when this machine cannot run its own model.
    local other=claude
    [[ -n "$NETWORK_URL" ]] && other=network
    st=$(server_state)
    [[ "$st" != down ]] && { echo "local (server $st)"; return; }
    gpu=$(gpu_vram) || { echo "$other (no NVIDIA GPU)"; return; }
    total=${gpu#*|}
    (( total < MIN_VRAM )) && { echo "$other (${gpu%|*}: ${total} MiB < ${MIN_VRAM} MiB)"; return; }
    [[ "$(systemctl --user show -p LoadState --value "$SERVER" 2>/dev/null)" == loaded ]] \
        || { echo "$other ($SERVER not installed — run setup.sh)"; return; }
    case "$(systemctl --user is-active "$SERVER" 2>/dev/null)" in
        active|activating) echo "local (model loading)";;
        failed)            echo "$other ($SERVER failed)";;
        *)                 echo "$other ($SERVER stopped — voice-llm qwen)";;
    esac
}

restart_assistant() {
    if systemctl --user is-active "$ASSISTANT" &>/dev/null; then
        info "Restarting $ASSISTANT"
        systemctl --user restart "$ASSISTANT"
    else
        warn "$ASSISTANT is not running (start it with: systemctl --user start $ASSISTANT)"
    fi
}

wait_ready() {
    local deadline=$((SECONDS + ${1:-300}))
    while (( SECONDS < deadline )); do
        [[ "$(server_state)" == ready ]] && return 0
        systemctl --user is-failed "$SERVER" &>/dev/null && return 1
        sleep 2
    done
    return 1
}

case "${1:-status}" in
  status)
    echo "Voice assistant LLM backend"
    echo "==========================="
    cfg=$(current_backend)
    echo -e "Configured:     ${GREEN}${cfg}${NC}"
    echo -e "Resolved:       ${GREEN}$(resolve_backend "$cfg")${NC}"
    case "$(server_state)" in
        ready)   echo -e "Model server:   ${GREEN}serving${NC} ($HEALTH)";;
        loading) echo -e "Model server:   ${YEL}loading${NC} (503 until the weights are in)";;
        *)       echo -e "Model server:   ${RED}down${NC}";;
    esac
    systemctl --user is-active "$SERVER"    &>/dev/null \
        && echo -e "$SERVER:  ${GREEN}active${NC}" || echo -e "$SERVER:  ${RED}inactive${NC}"
    systemctl --user is-active "$ASSISTANT" &>/dev/null \
        && echo -e "Assistant:      ${GREEN}running${NC}" || echo -e "Assistant:      ${RED}stopped${NC}"
    if command -v nvidia-smi &>/dev/null; then
        nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader \
            | sed 's/^/GPU:            /'
    else
        echo "GPU:            none (nvidia-smi not installed)"
    fi
    ;;

  auto)
    set_backend auto
    restart_assistant
    ok "Backend is AUTO: local model when this machine can run it, Claude otherwise"
    echo "   resolved right now: $(resolve_backend auto)"
    ;;

  qwen|local)
    if ! systemctl --user cat "$SERVER" &>/dev/null; then
        err "$SERVER is not installed on this machine — run ./setup.sh"
        exit 1
    fi
    info "Starting $SERVER ($MODEL_NAME onto the dGPU)"
    systemctl --user enable --now "$SERVER" &>/dev/null || systemctl --user start "$SERVER"
    info "Waiting for the model to load (~5 s warm, ~35 s cold)..."
    if wait_ready 300; then
        ok "Model server is serving"
    else
        err "Model server did not come up"
        echo "  journalctl --user -u $SERVER -n 40 --no-pager"
        exit 1
    fi
    # `auto` already prefers a server that answers, and the assistant's watcher
    # adopts it within three seconds, so there is no restart to wait through.
    was=$(current_backend)
    set_backend auto
    # Away from anything forced but the local model itself (claude, network,
    # dsh), the running assistant has to re-read it.
    case "$was" in auto|local) ;; *) restart_assistant ;; esac
    ok "Voice assistant answers with the LOCAL $MODEL_NAME (run_shell tool, offline)"
    ;;

  dsh)
    if ! systemctl --user cat "$SERVER" &>/dev/null; then
        err "$SERVER is not installed on this machine — run ./setup.sh"
        exit 1
    fi
    if ! "$REPO_DIR/.venv/bin/python" -c 'import deepseek_harness' &>/dev/null; then
        err "deepseek-harness-sdk is not installed — run ./setup.sh (or: .venv/bin/pip install deepseek-harness-sdk)"
        exit 1
    fi
    info "Starting $SERVER ($MODEL_NAME onto the dGPU)"
    systemctl --user enable --now "$SERVER" &>/dev/null || systemctl --user start "$SERVER"
    info "Waiting for the model to load (~5 s warm, ~35 s cold)..."
    if wait_ready 300; then
        ok "Model server is serving"
    else
        err "Model server did not come up"
        echo "  journalctl --user -u $SERVER -n 40 --no-pager"
        exit 1
    fi
    # The running assistant switches without a restart when asked over its
    # control socket; the env file is what a later restart reads.
    if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/voice-assistant.sock" ]] \
        && command -v assistant &>/dev/null && assistant --backend dsh &>/dev/null; then
        :
    else
        set_backend dsh
        restart_assistant
    fi
    ok "Voice assistant answers with the DEEPSEEK HARNESS on the local $MODEL_NAME (bash, editor, web tools)"
    ;;

  network)
    if [[ -z "$NETWORK_URL" ]]; then
        err "No network model: set VOICE_ASSISTANT_NETWORK_URL in $ENV_FILE"
        exit 1
    fi
    # Same as dsh: over the control socket when the assistant is up.
    if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/voice-assistant.sock" ]] \
        && command -v assistant &>/dev/null && assistant --backend network &>/dev/null; then
        :
    else
        set_backend network
        restart_assistant
    fi
    ok "Voice assistant answers with the NETWORK model at $NETWORK_URL"
    ;;

  claude)
    set_backend claude
    restart_assistant
    if systemctl --user is-active "$SERVER" &>/dev/null; then
        info "Stopping $SERVER to free the dGPU"
        systemctl --user stop "$SERVER"
    fi
    if [[ "${2:-}" == "--disable" ]]; then
        systemctl --user disable "$SERVER" &>/dev/null && info "$SERVER will not return at boot"
    fi
    ok "Voice assistant answers with CLAUDE CODE (tools, filesystem, web)"
    ;;

  logs)
    journalctl --user -u "$SERVER" -f
    ;;

  discover)
    # OpenAI-compatible servers on this machine's /24, one "<url> <model>
    # <host name>" line each on stdout, in address order. Polite: two
    # ports, a short connect timeout, and an HTTP request only to a port that
    # answered. This machine is left out, and so is its configured local
    # server wherever that is.
    exec python3 - "$(env_value VOICE_ASSISTANT_LOCAL_URL)" \
        ${VOICE_LLM_DISCOVER_PORTS:-8080 8081} <<'PY'
import concurrent.futures as cf
import ipaddress
import json
import os
import socket
import subprocess
import sys
import urllib.parse
import urllib.request

local_url, ports = sys.argv[1], [int(p) for p in sys.argv[2:]]


def addresses(*args):
    out = subprocess.run(["ip", "-4", "-o", *args], capture_output=True, text=True).stdout
    return [ipaddress.ip_interface(w[i + 1]) for w in map(str.split, out.splitlines())
            for i, x in enumerate(w) if x == "inet"]


mine = addresses("addr", "show")
# The LAN is wherever the default route goes; a docker or VM bridge is not.
lan_devs = {w[w.index("dev") + 1] for w in map(str.split, subprocess.run(
    ["ip", "-4", "route", "show", "default"], capture_output=True, text=True
).stdout.splitlines()) if "dev" in w}
lan = [a for d in lan_devs for a in addresses("addr", "show", "dev", d, "scope", "global")]
if not lan:
    sys.exit("discover: no default route, so no LAN to look on")
skip = {a.ip for a in mine}
u = urllib.parse.urlsplit(local_url) if local_url else None
skip_ep = {(u.hostname, u.port or 80)} if u and u.hostname else set()
# Never wider than a /24, and never wider than the interface's own subnet.
nets = {ipaddress.ip_interface(f"{a.ip}/{max(a.network.prefixlen, 24)}").network for a in lan}
targets = [(str(h), p) for n in nets for h in n.hosts() if h not in skip for p in ports
           if (str(h), p) not in skip_ep]


def open_port(t):
    try:
        with socket.create_connection(t, timeout=0.3):
            return t
    except OSError:
        return None


def model(t):
    try:
        with urllib.request.urlopen(f"http://{t[0]}:{t[1]}/v1/models", timeout=2) as r:
            d = json.load(r)
        items = d.get("data") or d.get("models") or []
        ids = [m.get("id") or m.get("model") or m.get("name") for m in items if isinstance(m, dict)]
        return next((i for i in ids if i), None)
    except Exception:
        return None


ex = cf.ThreadPoolExecutor(128)
found = [t for t in ex.map(open_port, targets) if t]
models = list(ex.map(model, found))
names = {}
for t, m in zip(found, models):
    if m:
        # Reverse DNS can hang where there is none; a name is only a label.
        names[t] = ex.submit(lambda ip: socket.gethostbyaddr(ip)[0], t[0])
for t, m in zip(found, models):
    if not m:
        continue
    try:
        name = names[t].result(timeout=1)
    except Exception:
        name = "-"
    print(f"http://{t[0]}:{t[1]}/v1 {m} {name}", flush=True)
# Not a `with` block, and no normal exit: either would wait out a reverse
# lookup that is still hanging, and setup.sh reads until this exits.
os._exit(0)
PY
    ;;

  *)
    echo "usage: voice-llm [status|auto|claude|qwen|network|dsh|logs|discover]"
    echo
    echo "  status   what is configured, what it resolves to, and why"
    echo "  auto     pick per machine: local model if it fits, Claude otherwise (default)"
    echo "  qwen     start the model server and prefer it (the assistant's own tool loop)"
    echo "  dsh      start the model server and drive it with the DeepSeek Harness"
    echo "  claude   force Claude and stop the model server (frees the GPU)"
    echo "           add --disable to keep it from starting at boot"
    echo "  logs     follow the model server"
    echo "  discover look for a model server on the LAN (for VOICE_ASSISTANT_NETWORK_URL)"
    exit 2
    ;;
esac
